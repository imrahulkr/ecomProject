# Variables for docker-compose.yml. Copy to .env (gitignored) and fill in.

# Required: JWT signing key, base64, at least 256 bits. Generate one with:
#   openssl rand -base64 64
APP_JWT_SECRET=

DB_PASSWORD=ecommerce

# Stripe TEST keys from the same account (Dashboard > Developers > API keys, Test mode).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=

# Optional: Razorpay test keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
