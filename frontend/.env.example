# Copy to .env.local and adjust.

# Where API calls go. Leave empty in dev - Vite proxies /api and /images to the backend.
# In production set it to the backend origin, e.g. https://api.example.com
VITE_API_BASE_URL=

# Backend origin used for full-page OAuth navigation (/oauth2/authorization/{provider})
# and by the dev proxy.
VITE_BACKEND_ORIGIN=http://localhost:8080

# Base URL for product images that the API returns as bare filenames. Empty = "{VITE_API_BASE_URL}/images".
VITE_IMAGE_BASE_URL=

# Stripe publishable key (pk_test_...). The backend does not expose it.
VITE_STRIPE_PUBLISHABLE_KEY=
